{
  "name": "@sentris/backend-client",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ../../openapi.json --output src/client.ts && echo '✅ Client types regenerated from OpenAPI spec'",
    "lint": "eslint . --cache --cache-location ../../.cache/eslint/backend-client/ --cache-strategy content",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.12.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.3"
  }
}
