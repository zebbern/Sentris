# Sentris backend environment defaults

# Trust profile: trusted-local keeps single-admin self-hosting simple. Use
# hardened only with external organization auth for untrusted/shared users.
SENTRIS_TRUST_PROFILE="trusted-local"

# Primary Postgres database connection
DATABASE_URL="postgresql://sentris:sentris@localhost:5433/sentris_instance_0"

# HTTP server configuration
PORT="3211"
# Public frontend base URL used in Slack/Discord lifecycle notification links
SENTRIS_FRONTEND_BASE_URL="http://localhost:5173"
# Comma-separated frontend origins allowed to call a separately hosted API.
# Local session auth supports same-site origins; use HTTPS in production.
CORS_ALLOWED_ORIGINS=""

# Optional product analytics. Analytics is disabled unless both values are set;
# DISABLE_ANALYTICS=true is an explicit runtime kill switch.
POSTHOG_API_KEY=""
POSTHOG_HOST=""
DISABLE_ANALYTICS="false"

# Temporal connection details
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="sentris-dev-0"
TEMPORAL_TASK_QUEUE="sentris-dev-0"

# MinIO credentials for artifact storage
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"

# Loki configuration for log retrieval
LOKI_URL="http://localhost:3100"
# Optional: multi-tenant org / basic auth credentials
LOKI_TENANT_ID=""
LOKI_USERNAME=""
LOKI_PASSWORD=""
LOKI_PUSH_TIMEOUT_MS="10000"

# Authentication configuration
# Set AUTH_PROVIDER="local" to enable developer mode or "clerk" to integrate with the platform identity service.
AUTH_PROVIDER="local"

# Local provider options
# Development defaults to admin/admin when these are omitted. Both values are
# required when NODE_ENV=production and AUTH_PROVIDER=local.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# If AUTH_LOCAL_ALLOW_UNAUTHENTICATED=false, clients must present AUTH_LOCAL_API_KEY in the Authorization header.
AUTH_LOCAL_ALLOW_UNAUTHENTICATED="true"
AUTH_LOCAL_API_KEY=""
# Required in production for session auth cookie signing
SESSION_SECRET=""

# Clerk provider options
# Required when AUTH_PROVIDER="clerk"
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Jira Cloud OAuth (optional; set all three values or leave all three blank)
# Register this exact frontend callback URL in the Atlassian developer console.
# Local example: http://localhost:5173/settings/ticketing/callback
JIRA_CLIENT_ID=""
JIRA_CLIENT_SECRET=""
JIRA_CALLBACK_URL=""

# Platform service account (optional, used for auth enrichment + workflow linkage)
PLATFORM_API_URL=""
PLATFORM_SERVICE_TOKEN=""
# Optional: override request timeout in milliseconds (default 5000)
PLATFORM_API_TIMEOUT_MS=""

# OpenSearch configuration for security analytics indexing
# Optional: if not set, security analytics indexing will be disabled
OPENSEARCH_URL=""
OPENSEARCH_USERNAME=""
OPENSEARCH_PASSWORD=""
# Per-attempt tenant provisioning request timeout (100-10000ms).
OPENSEARCH_TENANT_FETCH_TIMEOUT_MS=5000
# Disable only the automatic five-minute findings reconciliation schedule.
# Direct reconciliation calls remain available; release smoke sets this false.
FINDINGS_RECONCILIATION_SCHEDULE_ENABLED=true

# OpenSearch Dashboards configuration for analytics visualization
# Optional: if not set, Dashboards link will not appear in frontend sidebar
# Dev/Prod (via nginx): "http://localhost/analytics"
# Custom domain: "https://dashboards.example.com/analytics"
OPENSEARCH_DASHBOARDS_URL=""

# Secret encryption key (must be exactly 32 characters, NOT hex-encoded)
# Generate with: openssl rand -base64 24 | head -c 32
SECRET_STORE_MASTER_KEY="CHANGE_ME_32_CHAR_SECRET_KEY!!!!"

# Redis configuration for rate limiting and caching
# Optional: if not set, rate limiting will use in-memory storage (not recommended for production)
REDIS_URL=""

# Kafka / Redpanda configuration for node I/O, log, and event ingestion
LOG_KAFKA_BROKERS="localhost:19092"
# Keep this declaration aligned with Kafka/Redpanda topic retention.
TELEMETRY_KAFKA_REPLAY_RETENTION_DAYS=7
# Validation requires this to remain longer than the declared replay window.
TELEMETRY_KAFKA_RECEIPT_RETENTION_DAYS=30
# Safely resolved notification history is removed in bounded hourly batches.
NOTIFICATION_DELIVERY_RETENTION_DAYS=90

# Docker MCP Registry catalog sync
# Optional: GitHub personal access token — increases API rate limit from 60 to 5,000 req/hr
GITHUB_REGISTRY_TOKEN=""
# Optional: disable automatic daily catalog sync (default: true)
MCP_REGISTRY_SYNC_ENABLED="true"
# Optional: override the registry GitHub repository (default: docker/mcp-registry)
MCP_REGISTRY_REPO="docker/mcp-registry"
