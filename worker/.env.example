DATABASE_URL=postgresql://sentris:sentris@localhost:5433/sentris_instance_0
# Bound blackholed database/Redis peers so required telemetry can fail over.
WORKER_DATABASE_CONNECTION_TIMEOUT_MS=10000
WORKER_DATABASE_QUERY_TIMEOUT_MS=30000
TERMINAL_REDIS_COMMAND_TIMEOUT_MS=10000

# Trust profile: trusted-local is appropriate for one trusted administrator.
# Shared/multi-organization deployments should use hardened.
SENTRIS_TRUST_PROFILE=trusted-local

# Exact resource ownership scope used for Docker container/volume cleanup.
SENTRIS_DEPLOYMENT_ID=sentris
SENTRIS_INSTANCE=0

# MinIO Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=sentris-files

# Temporal Configuration
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=sentris-dev-0
TEMPORAL_TASK_QUEUE=sentris-dev-0

# Per-process MCP runtime ownership. PM2 derives these automatically from
# SENTRIS_INSTANCE, and the bundled production Compose file supplies its own
# service-reachable values. Set them together only when launching a worker
# directly; the advertised URL port must match the listen port.
# MCP_RUNTIME_OWNER_ID=sentris-worker-0
# MCP_RUNTIME_OWNER_URL=http://127.0.0.1:9301
# MCP_RUNTIME_LISTEN_HOST=127.0.0.1
# MCP_RUNTIME_LISTEN_PORT=9301
# MCP_RUNTIME_REDIS_URL=redis://localhost:6379

# Public browser-reachable API/nginx origin used in human-input links.
# Required in production; this must not be the worker's internal BACKEND_URL.
SENTRIS_PUBLIC_API_BASE_URL=http://localhost

# Loki Configuration
LOKI_URL=http://localhost:3100
# Optional: multi-tenant parameters or basic auth
LOKI_TENANT_ID=
LOKI_USERNAME=
LOKI_PASSWORD=

# Secret encryption key (must be exactly 32 characters, NOT hex-encoded)
# Generate with: openssl rand -base64 24 | head -c 32
SECRET_STORE_MASTER_KEY=CHANGE_ME_32_CHAR_SECRET_KEY!!!!

# OpenSearch Configuration (Optional - for Analytics Sink component)
# Leave empty to disable analytics indexing
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# OpenSearch Dashboards URL for auto-refreshing index patterns after indexing
# - Dev mode (worker on host, nginx routing): http://localhost/analytics
# - Docker mode (worker inside Docker): http://opensearch-dashboards:5601/analytics (set in docker-compose)
# Note: Include the basePath (/analytics) as configured in opensearch_dashboards.yml
OPENSEARCH_DASHBOARDS_URL=http://localhost/analytics

# Worker health server port (optional, defaults to 9100)
# For multi-instance setups, use 9100 + instanceNum * 100
# WORKER_HEALTH_PORT=9100

# Trusted single-admin local use only. Enables a same-worker loopback host proxy
# that starts stdio MCP commands directly on this worker. Leave false/undefined
# for multi-user, distributed, container-isolated, or hardened self-hosting.
# MCP_DISCOVERY_TRUSTED_LOCAL_STDIO=false

# Docker security component resource caps (optional)
# SENTRIS_DOCKER_MAX_MEMORY=8g
# SENTRIS_DOCKER_MAX_CPUS=4

# Production DIND only: mount this same absolute path into the worker and DIND
# daemon. Each component receives a separate run-scoped subdirectory.
# SENTRIS_DOCKER_SHARED_IO_ROOT=/sentris-docker-io
# SENTRIS_DIND_HOST=dind
#
# Authenticated worker-owned proxy for Docker MCP transports. The public base
# must be reachable by backend containers but does not need a host-published port.
# MCP_DOCKER_PROXY_PORT=9101
# MCP_DOCKER_PROXY_PUBLIC_BASE_URL=http://worker:9101
# MCP_DOCKER_PROXY_TOKEN=generate-a-long-random-token
#
# Bounded startup and periodic orphan reconciliation defaults.
# WORKER_ORPHAN_MIN_AGE_MS=3600000
# WORKER_ORPHAN_INTERVAL_MS=900000
# WORKER_ORPHAN_MAX_RESOURCES=100
# WORKER_ORPHAN_MAX_INVENTORY=500
# WORKER_ORPHAN_DOCKER_TIMEOUT_MS=10000
# WORKER_ORPHAN_RUN_STATE_TIMEOUT_MS=3000

# Kafka / Redpanda configuration for log and event ingestion
LOG_KAFKA_BROKERS=localhost:9092

# Internal service token for worker-to-backend API calls
# BACKEND_URL=http://localhost:3211
INTERNAL_SERVICE_TOKEN=change-me-to-a-secure-token
