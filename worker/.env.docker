# Sentris worker environment for Docker containers

# The all-in-one Docker example is a single-admin local deployment.
SENTRIS_TRUST_PROFILE="trusted-local"
SENTRIS_DEPLOYMENT_ID="sentris"
SENTRIS_INSTANCE="0"

# Database connection (Docker network)
DATABASE_URL="postgresql://sentris:sentris@postgres:5432/sentris"

# MinIO configuration (Docker network)
MINIO_ENDPOINT="minio"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="sentris-files"

# Temporal configuration (Docker network)
TEMPORAL_ADDRESS="temporal:7233"
TEMPORAL_NAMESPACE="sentris-prod"
TEMPORAL_TASK_QUEUE="sentris-prod"

# Backend callbacks (Docker network; /api/v1 is added by the worker)
BACKEND_URL="http://backend:3211"
# Public browser-reachable API/nginx origin used in human-input links
SENTRIS_PUBLIC_API_BASE_URL="http://localhost"

# Docker MCP containers publish random DIND ports behind this authenticated,
# worker-owned app-network proxy.
SENTRIS_DIND_HOST="dind"
MCP_DOCKER_PROXY_PORT="9101"
MCP_DOCKER_PROXY_PUBLIC_BASE_URL="http://worker:9101"
# Optional; generated randomly at worker startup when omitted.
MCP_DOCKER_PROXY_TOKEN=""

# Loki configuration (Docker network)
LOKI_URL="http://loki:3100"

# Secret encryption key (must be exactly 32 characters, NOT hex-encoded)
SECRET_STORE_MASTER_KEY="CHANGE_ME_32_CHAR_SECRET_KEY!!!!"

# Kafka / Redpanda configuration for log and event ingestion (Docker network)
LOG_KAFKA_BROKERS="redpanda:9092"
